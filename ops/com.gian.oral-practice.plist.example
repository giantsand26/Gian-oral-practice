<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.gian.oral-practice</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/zsh</string>
    <string>-lc</string>
    <string>cd "&lt;ABSOLUTE_APP_DIRECTORY&gt;" &amp;&amp; exec "&lt;ABSOLUTE_NPM_PATH&gt;" start</string>
  </array>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>WorkingDirectory</key>
  <string>&lt;ABSOLUTE_APP_DIRECTORY&gt;</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>GIAN_ALLOWED_HOSTS</key>
    <string>&lt;EXACT_TAILSCALE_HOSTNAME&gt;</string>
    <key>GIAN_TIMEZONE</key>
    <string>&lt;IANA_TIMEZONE&gt;</string>
  </dict>
  <key>StandardOutPath</key>
  <string>&lt;ABSOLUTE_APP_DIRECTORY&gt;/.runtime/app.stdout.log</string>
  <key>StandardErrorPath</key>
  <string>&lt;ABSOLUTE_APP_DIRECTORY&gt;/.runtime/app.stderr.log</string>
</dict>
</plist>
